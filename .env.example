GEMINI_API_KEY="your_gemini_free_tier_key"
PEXELS_API_KEY="your_pexels_key"
COMFYUI_SERVER_URL="http://127.0.0.1:8188"
# Optional: exported ComfyUI API workflow JSON that contains a CLIPTextEncode node.
COMFYUI_WORKFLOW_PATH=""
# Optional but recommended: the node ID of the positive CLIPTextEncode node in the API workflow.
COMFYUI_POSITIVE_PROMPT_NODE_ID=""
# Required only for local Piper narration. One model/config pair is needed per language.
PIPER_MODEL_PATH_RO="C:\\AI\\Piper\\models\\ro_RO-mihai-medium.onnx"
PIPER_CONFIG_PATH_RO="C:\\AI\\Piper\\models\\ro_RO-mihai-medium.onnx.json"
